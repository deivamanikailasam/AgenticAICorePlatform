{
  "uid": "agent-platform",
  "title": "Agent platform",
  "tags": [
    "agent-platform",
    "step-30"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Agentic AI Core Platform: runs, success, latency, steps, tools, approvals, cost, budget trips, guardrails (Step 30)",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(agent_platform_runs_total, gen_ai_agent_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/deivamanikailasam/AgenticAICorePlatform/tree/main/docs/runbooks",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs per minute by status",
      "description": "Finished runs (agent_platform.runs)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent_platform_run_status) (rate(agent_platform_runs_total{gen_ai_agent_name=~\"$agent\"}[5m])) * 60",
          "legendFormat": "{{agent_platform_run_status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Run success ratio (1 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:run_success:ratio_rate1h{gen_ai_agent_name=~\"$agent\"}",
          "legendFormat": "{{gen_ai_agent_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Run time p50 / p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:invoke_agent_duration_seconds:p50_5m{gen_ai_agent_name=~\"$agent\"}",
          "legendFormat": "p50 {{gen_ai_agent_name}}"
        },
        {
          "refId": "B",
          "expr": "agent_platform:invoke_agent_duration_seconds:p95_5m{gen_ai_agent_name=~\"$agent\"}",
          "legendFormat": "p95 {{gen_ai_agent_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Steps per run (avg, 1 h)",
      "description": "Model calls per run",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:run_steps:avg_1h{gen_ai_agent_name=~\"$agent\"}",
          "legendFormat": "{{gen_ai_agent_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool error rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:tool_error:ratio_rate5m",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Approvals pending",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_agent_name) (agent_platform_approvals_pending{gen_ai_agent_name=~\"$agent\"})",
          "legendFormat": "{{gen_ai_agent_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost per tenant (AUD, last hour)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyAUD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:cost_aud:per_tenant_1h",
          "legendFormat": "{{agent_platform_tenant_id}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost per run (AUD, avg 1 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyAUD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_platform:cost_aud:per_run_avg_1h{gen_ai_agent_name=~\"$agent\"}",
          "legendFormat": "{{gen_ai_agent_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Budget trips (10 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_agent_name, limit) (increase(agent_platform_budget_trips_total{gen_ai_agent_name=~\"$agent\"}[10m]))",
          "legendFormat": "{{gen_ai_agent_name}} {{limit}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Guardrail hits (10 min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (guardrail, action) (increase(agent_platform_guardrail_hits_total[10m]))",
          "legendFormat": "{{guardrail}} {{action}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Model call time p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_input_tokens_total[5m])) * 60",
          "legendFormat": "in {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_output_tokens_total[5m])) * 60",
          "legendFormat": "out {{gen_ai_request_model}}"
        }
      ]
    }
  ]
}
