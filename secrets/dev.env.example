# Names of the dev secrets Project A needs. Copy to secrets/dev.env, fill in, then run
# `just secrets-init` to produce the encrypted secrets/dev.enc.env (the only form committed).
# Runtime secrets for tools never live here: they come from OpenBao at call time (Step 29).
P0_POSTGRES_ADMIN_DSN=
AGENT_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
LITELLM_MASTER_KEY=
AGENT_DB_DSN=
P0_S3_ACCESS_KEY=
P0_S3_SECRET_KEY=
# Step 29: OpenBao. The admin token is for provisioning only; the runtime logs in with the
# AppRole written to .tmp/openbao-approle.env by `just provision-openbao` (move both lines here)
OPENBAO_ADMIN_TOKEN=
AGENT_BAO_ROLE_ID=
AGENT_BAO_SECRET_ID=
