# Copy to .env (git-ignored) and adjust. No secrets here: secrets come from SOPS (dev) or
# OpenBao (runtime). Values below are the Project 0 defaults on the Mac — VERIFY against
# ~/dev/rag-platform/infra/compose before first use.
P0_NETWORK=rag-platform
P0_LITELLM_URL=http://127.0.0.1:4000
P0_POSTGRES_DSN=postgresql://agent_health@127.0.0.1:5432/postgres
P0_VALKEY_URL=redis://127.0.0.1:6379/0
P0_KEYCLOAK_URL=http://127.0.0.1:8080
P0_KEYCLOAK_REALM=rag-platform
P0_OPA_URL=http://127.0.0.1:8181
P0_OTEL_HEALTH_URL=http://127.0.0.1:13133/
P0_OTEL_OTLP_ENDPOINT=http://127.0.0.1:4318
P0_TEMPO_URL=http://127.0.0.1:3200
