{
  "$defs": {
    "A2a": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/A2aAgent"
          },
          "title": "Agents",
          "type": "array"
        },
        "publish": {
          "$ref": "#/$defs/A2aPublish",
          "default": {
            "base_url": "http://127.0.0.1:8092",
            "key_id": "agent-platform-1",
            "push_allowed_hosts": [],
            "signing_key": "${secret:agent-platform/a2a#signing_key}"
          }
        }
      },
      "title": "A2a",
      "type": "object"
    },
    "A2aAgent": {
      "additionalProperties": false,
      "description": "One allowlisted remote A2A agent (Step 24). Agents not listed here are refused, and a\nlisted agent's Agent Card must carry a valid signature from one of its pinned keys.",
      "properties": {
        "algorithms": {
          "items": {
            "type": "string"
          },
          "title": "Algorithms",
          "type": "array"
        },
        "auth": {
          "$ref": "#/$defs/McpAuth",
          "default": {
            "audience": null,
            "client_id": null,
            "client_secret": null,
            "issuer": null,
            "kind": "none",
            "scope": null,
            "token": null
          }
        },
        "binding": {
          "default": "JSONRPC",
          "enum": [
            "JSONRPC",
            "HTTP+JSON",
            "GRPC"
          ],
          "title": "Binding",
          "type": "string"
        },
        "card_keys": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Card Keys",
          "type": "object"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,40}$",
          "title": "Name",
          "type": "string"
        },
        "side_effect": {
          "default": "write",
          "enum": [
            "read",
            "write",
            "irreversible"
          ],
          "title": "Side Effect",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "card_keys"
      ],
      "title": "A2aAgent",
      "type": "object"
    },
    "A2aPublish": {
      "additionalProperties": false,
      "description": "How the a2a-gateway publishes this platform's agents.",
      "properties": {
        "base_url": {
          "default": "http://127.0.0.1:8092",
          "title": "Base Url",
          "type": "string"
        },
        "key_id": {
          "default": "agent-platform-1",
          "title": "Key Id",
          "type": "string"
        },
        "push_allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Push Allowed Hosts",
          "type": "array"
        },
        "signing_key": {
          "default": "${secret:agent-platform/a2a#signing_key}",
          "title": "Signing Key",
          "type": "string"
        }
      },
      "title": "A2aPublish",
      "type": "object"
    },
    "Currency": {
      "additionalProperties": false,
      "description": "LiteLLM accounts cost in USD; budgets and reports are in AUD.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "usd_to_aud": {
          "exclusiveMinimum": 0,
          "title": "Usd To Aud",
          "type": "number"
        }
      },
      "required": [
        "usd_to_aud",
        "source",
        "as_of"
      ],
      "title": "Currency",
      "type": "object"
    },
    "Gateway": {
      "additionalProperties": false,
      "properties": {
        "key_env_prefix": {
          "default": "LITELLM_KEY_",
          "title": "Key Env Prefix",
          "type": "string"
        },
        "max_retries": {
          "default": 2,
          "maximum": 6,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "url": {
          "default": "http://127.0.0.1:4000",
          "title": "Url",
          "type": "string"
        }
      },
      "title": "Gateway",
      "type": "object"
    },
    "Mcp": {
      "additionalProperties": false,
      "properties": {
        "servers": {
          "items": {
            "$ref": "#/$defs/McpServer"
          },
          "title": "Servers",
          "type": "array"
        }
      },
      "title": "Mcp",
      "type": "object"
    },
    "McpAuth": {
      "additionalProperties": false,
      "description": "How the platform authenticates to a remote MCP server.",
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "client_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "kind": {
          "default": "none",
          "enum": [
            "none",
            "oauth_client_credentials",
            "bearer",
            "on_behalf_of"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        }
      },
      "title": "McpAuth",
      "type": "object"
    },
    "McpServer": {
      "additionalProperties": false,
      "description": "One allowlisted MCP server. Servers not listed here are refused.",
      "properties": {
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "auth": {
          "$ref": "#/$defs/McpAuth",
          "default": {
            "audience": null,
            "client_id": null,
            "client_secret": null,
            "issuer": null,
            "kind": "none",
            "scope": null,
            "token": null
          }
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "env_passthrough": {
          "items": {
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,40}$",
          "title": "Name",
          "type": "string"
        },
        "protocol": {
          "default": "auto",
          "enum": [
            "auto",
            "legacy",
            "2026-07-28"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "side_effects": {
          "additionalProperties": {
            "enum": [
              "read",
              "write",
              "irreversible"
            ],
            "type": "string"
          },
          "title": "Side Effects",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "transport": {
          "enum": [
            "http",
            "stdio"
          ],
          "title": "Transport",
          "type": "string"
        },
        "trusted": {
          "default": false,
          "title": "Trusted",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "transport"
      ],
      "title": "McpServer",
      "type": "object"
    },
    "ModelCapabilities": {
      "additionalProperties": false,
      "properties": {
        "context_window": {
          "default": 8192,
          "exclusiveMinimum": 0,
          "title": "Context Window",
          "type": "integer"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        },
        "structured_output": {
          "default": false,
          "title": "Structured Output",
          "type": "boolean"
        },
        "tool_calling": {
          "default": false,
          "title": "Tool Calling",
          "type": "boolean"
        }
      },
      "title": "ModelCapabilities",
      "type": "object"
    },
    "Models": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelCapabilities"
          },
          "title": "Capabilities",
          "type": "object"
        },
        "fallbacks": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Fallbacks",
          "type": "object"
        },
        "roles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Roles",
          "type": "object"
        }
      },
      "required": [
        "roles"
      ],
      "title": "Models",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "a2a": {
      "$ref": "#/$defs/A2a",
      "default": {
        "agents": [],
        "publish": {
          "base_url": "http://127.0.0.1:8092",
          "key_id": "agent-platform-1",
          "push_allowed_hosts": [],
          "signing_key": "${secret:agent-platform/a2a#signing_key}"
        }
      }
    },
    "components": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Components",
      "type": "object"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "gateway": {
      "$ref": "#/$defs/Gateway",
      "default": {
        "key_env_prefix": "LITELLM_KEY_",
        "max_retries": 2,
        "timeout_seconds": 60.0,
        "url": "http://127.0.0.1:4000"
      }
    },
    "mcp": {
      "$ref": "#/$defs/Mcp",
      "default": {
        "servers": []
      }
    },
    "models": {
      "$ref": "#/$defs/Models"
    },
    "platform_version": {
      "const": 1,
      "default": 1,
      "title": "Platform Version",
      "type": "integer"
    }
  },
  "required": [
    "models",
    "currency"
  ],
  "title": "platform.yaml (platform_version 1)",
  "type": "object"
}
