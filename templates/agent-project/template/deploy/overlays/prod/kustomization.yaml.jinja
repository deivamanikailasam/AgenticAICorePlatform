# prod: changed only by a reviewed pull request (`agentctl promote`); Argo CD syncs it. 3 replicas of
# each stateless service, workers scaled by KEDA between 2 and 10, Temporal cluster in
# namespace temporal-prod. Images by digest only.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: {{ project_slug }}-prod
resources:
  - namespace.yaml
  - https://github.com/deivamanikailasam/AgenticAICorePlatform//deploy/base?ref={{ platform_ref }}
components:
  - https://github.com/deivamanikailasam/AgenticAICorePlatform//deploy/components/cluster?ref={{ platform_ref }}
  # the versions deploy/releases/prod.yaml names (generated: agentctl deploy-config)
  - released
generatorOptions:
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
configMapGenerator:
  - name: agent-platform-env
    envs: [env.properties]
replicas:
  - { name: agent-api, count: 3 }
  - { name: mcp-gateway, count: 3 }
  - { name: a2a-gateway, count: 3 }
patches:
  - target: { kind: ScaledObject, name: agent-worker }
    patch: |-
      - { op: replace, path: /spec/minReplicaCount, value: 2 }
      - { op: replace, path: /spec/maxReplicaCount, value: 10 }
      - { op: replace, path: /spec/triggers/0/metadata/endpoint, value: "temporal-frontend.temporal-prod.svc:7233" }
  - target: { kind: NetworkPolicy, name: egress-temporal-cluster }
    patch: |-
      - op: replace
        path: /spec/egress/0/to/0/namespaceSelector/matchLabels/kubernetes.io~1metadata.name
        value: temporal-prod
# images from commit 1887123272b2b4823d1e8d71d95fc86d089e14c6 (images workflow; signed, scanned)
images:
  - { name: agent-platform/agent-api, newName: ghcr.io/deivamanikailasam/agent-platform/agent-api, digest: "sha256:d28c6201eb6b7e90e5cf41ae62db9f7a27e2c2ca9eeae2b3275802f97219a962" }
  - { name: agent-platform/agent-worker, newName: ghcr.io/deivamanikailasam/agent-platform/agent-worker, digest: "sha256:3883e1a4f765a5e9130307a612b2708b5f49b1960c24b53aae0bb1b4cfb5e556" }
  - { name: agent-platform/mcp-gateway, newName: ghcr.io/deivamanikailasam/agent-platform/mcp-gateway, digest: "sha256:19b41dde2f98d1ff66da16afb8725912c05079fbe3c183a7bee929bcd1dcaa6c" }
  - { name: agent-platform/a2a-gateway, newName: ghcr.io/deivamanikailasam/agent-platform/a2a-gateway, digest: "sha256:6623b0d23a98ea1ce26ef9401c03277e1521582811d3c87ec260287251b94747" }
  - { name: agent-platform/ops, newName: ghcr.io/deivamanikailasam/agent-platform/ops, digest: "sha256:e02867a8375e16cd1a77a44a98bedc68a2f5c4b442239ddeaad879ff233a8ef4" }
