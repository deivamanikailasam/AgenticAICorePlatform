# Environment for every Project A pod in prod. No secrets here: values that need one are
# ${secret:...} references, resolved from this environment's OpenBao mount at start-up.
# Project 0 runs in the `rag-platform` namespace (VERIFY-ON-MAC: service names and ports).
AGENT_ENV=prod
P0_LITELLM_URL=http://litellm.rag-platform.svc:4000
P0_VALKEY_URL=redis://valkey.rag-platform.svc:6379/0
P0_KEYCLOAK_URL=http://keycloak.rag-platform.svc:8080
P0_KEYCLOAK_PUBLIC_URL=http://keycloak.rag-platform.svc:8080
P0_KEYCLOAK_REALM=rag-platform
AGENT_PLATFORM_CLIENT_ID={{ project_slug }}-prod
P0_OPA_URL=http://opa.rag-platform.svc:8181
P0_OTEL_OTLP_ENDPOINT=http://otel-collector.rag-platform.svc:4318
P0_OPENBAO_URL=http://openbao.rag-platform.svc:8200
AGENT_BAO_K8S_ROLE={{ project_slug }}-prod
AGENT_BAO_KV_MOUNT={{ project_slug }}-prod
P0_PRESIDIO_ANALYZER_URL=http://presidio-analyzer.rag-platform.svc:3000
P0_PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer.rag-platform.svc:3000
P0_RAG_CORE_URL=http://rag-core.rag-platform.svc:8000
AGENT_DB_DSN=${secret:agent-platform/db#dsn}
AGENT_AUDIT_DSN=${secret:agent-platform/audit#dsn}
TEMPORAL_ADDRESS=temporal-frontend.temporal-prod.svc:7233
MCP_GATEWAY_PUBLIC_URL=http://mcp-gateway:8090
MCP_GATEWAY_ALLOWED_HOSTS=mcp-gateway:*,mcp-gateway.{{ project_slug }}-prod.svc:*
A2A_PUBLIC_URL=http://a2a-gateway:8092
